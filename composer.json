{
    "name": "crehler/pay-now",
    "description": "PayNow Shopware Integration",
    "type": "shopware-platform-plugin",
    "license": "proprietary",
    "version": "6.6.2",
    "authors": [
        {
            "name": "Crehler Sp. z o. o.",
            "email": "support@crehler.com",
            "homepage": "https://crehler.com",
            "role": "Developer"
        },
        {
            "name": "mElements S.A.",
            "email": "contact@melements.pl",
            "homepage": "https://melements.pl",
            "role": "Owner"
        }
    ],
    "support": {
        "email": "contact@melements.pl"
    },
    "autoload": {
        "psr-4": {
            "Crehler\\PayNowPayment\\": "src/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Crehler\\PayNowPayment\\CrehlerPayNowPayment",
        "plugin-icon": "src/Resources/config/paynowpayment.png",
        "label": {
            "de-DE": "Zahlungsgateway PayNow",
            "en-GB": "Payment Gateway PayNow",
            "pl-PL": "Bramka płatności PayNow"
        },
        "description": {
            "de-DE": "PayNow von mBank für Shopware: BLIK direkt im Checkout, Pay-by-Link-Überweisungen, Kartenzahlungen und PayPo-Ratenkauf, dazu Erstattungen und automatische Statusupdates.",
            "en-GB": "PayNow by mBank for Shopware: BLIK codes right in checkout, pay-by-link bank transfers, card payments and PayPo deferred payments, plus refunds and automatic status updates.",
            "pl-PL": "PayNow od mBanku dla Shopware: BLIK wpisywany w koszyku, szybkie przelewy pay-by-link, płatności kartą i odroczone płatności PayPo, a także zwroty i automatyczna aktualizacja statusów."
        },
        "manufacturerLink": {
            "de-DE": "https://crehler.com/",
            "en-GB": "https://crehler.com/",
            "pl-PL": "https://crehler.com/"
        },
        "supportLink": {
            "de-DE": "https://crehler.com/",
            "en-GB": "https://crehler.com/",
            "pl-PL": "https://crehler.com/"
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "crehler/payment-bundle": "6.6.*",
        "pay-now/paynow-php-sdk": "^2.4",
        "shopware/core": "~6.6 || ~6.7"
    },
    "replace": {
        "crehler-pay-now-payment/shopware-integration": "*"
    },
    "require-dev": {
        "rector/rector": "^2.4"
    }
}
