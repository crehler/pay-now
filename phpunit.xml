<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/UnitTestBootstrap.php"
         executionOrder="random">
    <php>
        <ini name="error_reporting" value="-1"/>
        <env name="APP_ENV" value="test"/>
    </php>
    <testsuites>
        <!-- tests/TestBootstrap.php is the shop-booting bootstrap for integration tests;
             it needs a database, so it is not what the unit suite runs on. -->
        <testsuite name="CrehlerPayNowPayment Testsuite">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>./src/</directory>
        </include>
    </source>
</phpunit>
